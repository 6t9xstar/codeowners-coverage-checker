{
  "name": "ownerscope",
  "version": "1.0.0",
  "description": "GitHub CODEOWNERS validator and coverage checker. Finds files without code owners, rules that match nothing, shadowed rules and invalid owners, with a per-directory ownership report.",
  "type": "module",
  "bin": {
    "ownerscope": "bin/ownerscope.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "action.yml"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "codeowners",
    "github",
    "code-owners",
    "code-review",
    "coverage",
    "validator",
    "linter",
    "ownership",
    "cli",
    "github-action",
    "codeowners validator"
  ],
